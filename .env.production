# Build settings only. No credentials live here.
#
# The anon key is deliberately NOT in this file. It belongs in .env, which is
# gitignored, or in the host's environment settings. It is public by design and
# ships in the bundle either way, but keeping it out of the repo means the key
# can be rotated without rewriting git history, which is what had to be done
# once already.
GENERATE_SOURCEMAP=false
