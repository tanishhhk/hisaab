# Create React App prefers this over .env when NODE_ENV=test. Blank Supabase
# settings make src/supabase.ts hand back null, which is the path the tests
# should exercise: the suite then runs offline and deterministically instead
# of reaching the real project and warning about state updates outside act().
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
